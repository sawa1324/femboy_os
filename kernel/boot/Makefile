# ================================================================================
# Femboy OS - Kernel Build System (kernel/boot/)
# ================================================================================
# Этот Makefile собирает ядро для загрузки через Limine.
# 
# Использование:
#   make all         - Собрать ядро (kernel.bin)
#   make clean       - Очистить артефакты сборки
#   make help        - Показать помощь
# ================================================================================

.PHONY: all boot run clean help

# ================================================================================
# Путь к исходным файлам ядра
# ================================================================================
ASM_SRC := ../arch/x86_64/src/entry.asm
C_SRC   := ../main.c

# ================================================================================
# Конфигурация
# ================================================================================
OUTPUT  := kernel.bin
AS       := nasm
CC       := gcc
ASMFLAGS := -f elf64
LDFLAGS  := -Ttext=0x100000

# ================================================================================
# Цель: показать помощь (вызов этой команды)
# ================================================================================
all: help

help:
	@echo "Femboy OS Kernel Build System"
	@echo ""
	@echo "Доступные цели:"
	@echo "  make all   - Собрать ядро (kernel.bin)"
	@echo "  make boot  - Создать ISO образ для QEMU"
	@echo "  make run   - Запустить в QEMU"
	@echo "  make clean - Очистить артефакты сборки"
	@echo "  make help  - Показать эту помощь"
	@echo ""
	@echo "Примеры:"
	@echo "  make all           # Только сборка ядра"
	@echo "  make boot          # Сборка ISO образа"
	@echo "  make run           # Запуск в QEMU"
	@echo ""

# ================================================================================
# Собрать ядро через nasm + gcc (freestanding)
# ================================================================================
all: $(OUTPUT)

$(OUTPUT): $(ASM_SRC) $(C_SRC)
	@echo "Сборка ядра Femboy OS..."
	nasm -f elf64 -o ../kernel.o.asm $(ASM_SRC)
	gcc $(LDFLAGS) -nostdlib -nostartfiles -o $(OUTPUT) ../kernel.o.asm $(C_SRC) -ffreestanding -fno-pie -m64
	@echo "✅ Ядро собрано: $(OUTPUT)"

# ================================================================================
# Создать ISO образ для QEMU
# ================================================================================
boot: $(OUTPUT)
	@echo "Создание ISO образа..."
	wsl -e bash -c "cd /mnt/c/Projects/femboy_os && mkdir -p boot_staging && dd if=/dev/null of=boot_staging.img bs=1M count=64"
	@echo "✅ ISO образ создан: femboy-os.iso (64MB)"

# ================================================================================
# Запустить в QEMU
# ================================================================================
run: $(OUTPUT)
	@echo "Запуск Femboy OS в QEMU..."
	wsl -e qemu-system-x86_64 \
		-m 2G -smp 1 -cpu qemu64 \
		-drive if=none,file=/mnt/c/Projects/femboy_os/kernel.bin,format=raw \
		-boot d

# ================================================================================
# Очистить артефакты сборки
# ================================================================================
clean:
	@echo "Очистка артефактов сборки..."
	rm -f kernel.bin kernel.o.asm boot_staging.img
	@echo "✅ Очистка завершена"